    {
      "name": "Trades CRUD",
      "item": [
        {
          "name": "Create Trade",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Trade created successfully', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData).to.have.property('pnl');",
                  "    pm.environment.set('tradeId', jsonData.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"ticker\": \"BTCUSDT\", \"direction\": \"long\", \"opened_at\": \"2024-01-01T10:00:00\", \"closed_at\": \"2024-01-01T12:00:00\", \"initial_volume\": \"0.1\", \"open_price\": \"40000\", \"close_price\": \"45000\", \"commission\": \"10\", \"journal_id\": \"{{journalId}}\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/trades",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "trades"]
            }
          }
        },
        {
          "name": "List Trades",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Returns trades list', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('items');",
                  "    pm.expect(jsonData.items).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/trades",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "trades"]
            }
          }
        },
        {
          "name": "Filter Trades by Journal",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Returns filtered trades', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.items).to.be.an('array');",
                  "    if (jsonData.items.length > 0) {",
                  "        pm.expect(jsonData.items[0].journal_id).to.eql(pm.environment.get('journalId'));",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/trades?journal_id={{journalId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "trades"],
              "query": [{"key": "journal_id", "value": "{{journalId}}"}]
